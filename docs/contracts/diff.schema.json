{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ETABS model diff",
  "description": "Output of the diff engine, input of the viewer. See docs/contracts/diff-json.md.",
  "type": "object",
  "required": [
    "schema_version",
    "before",
    "after",
    "units",
    "tolerances",
    "stories",
    "summary",
    "objects",
    "definitions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "before": {
      "$ref": "#/$defs/source"
    },
    "after": {
      "$ref": "#/$defs/source"
    },
    "units": {
      "type": "object",
      "required": [
        "force",
        "length",
        "temperature"
      ],
      "properties": {
        "force": {
          "const": "KIP"
        },
        "length": {
          "const": "FT"
        },
        "temperature": {
          "const": "F"
        }
      }
    },
    "tolerances": {
      "type": "object",
      "required": [
        "match",
        "rel",
        "abs"
      ],
      "additionalProperties": false,
      "properties": {
        "match": {
          "type": "number",
          "description": "ft. Max vertex distance for two objects to count as the same object"
        },
        "rel": {
          "type": "number",
          "description": "relative tolerance for comparing numeric field values"
        },
        "abs": {
          "type": "number",
          "description": "absolute tolerance for comparing numeric field values"
        }
      }
    },
    "stories": {
      "type": "object",
      "required": [
        "before",
        "after"
      ],
      "additionalProperties": false,
      "properties": {
        "before": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/story"
          }
        },
        "after": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/story"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "point",
        "frame",
        "area",
        "definitions"
      ],
      "additionalProperties": false,
      "properties": {
        "point": {
          "$ref": "#/$defs/counts"
        },
        "frame": {
          "$ref": "#/$defs/counts"
        },
        "area": {
          "$ref": "#/$defs/counts"
        },
        "definitions": {
          "type": "object",
          "required": [
            "added",
            "removed",
            "modified"
          ],
          "additionalProperties": false,
          "properties": {
            "added": {
              "type": "integer"
            },
            "removed": {
              "type": "integer"
            },
            "modified": {
              "type": "integer"
            }
          }
        }
      }
    },
    "objects": {
      "description": "Every spatial object from both models, unchanged ones included, sorted by (kind, after_id or before_id).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "definitions": {
      "description": "Changed non-spatial definitions only, sorted by (category, name). Story changes use category 'stories'.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "name",
          "status",
          "changes"
        ],
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "added",
              "removed",
              "modified"
            ]
          },
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/change"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "file",
        "program",
        "program_version",
        "file_units"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "program": {
          "type": "string"
        },
        "program_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "file_units": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "story": {
      "type": "object",
      "required": [
        "name",
        "elev",
        "height"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "elev": {
          "type": "number"
        },
        "height": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "unchanged",
        "added",
        "removed",
        "modified",
        "relabeled"
      ],
      "additionalProperties": false,
      "properties": {
        "unchanged": {
          "type": "integer"
        },
        "added": {
          "type": "integer"
        },
        "removed": {
          "type": "integer"
        },
        "modified": {
          "type": "integer"
        },
        "relabeled": {
          "type": "integer"
        }
      }
    },
    "change": {
      "type": "object",
      "required": [
        "field",
        "before",
        "after"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "description": "Dotted path, e.g. label, assigns.SECTION, loads.LIVE, LOADCASE.SDL"
        },
        "before": {
          "description": "null when the field did not exist before"
        },
        "after": {
          "description": "null when the field does not exist after"
        }
      }
    },
    "object": {
      "type": "object",
      "required": [
        "kind",
        "status",
        "type",
        "before_id",
        "after_id",
        "label",
        "story",
        "coords",
        "section",
        "offset",
        "changes"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "point",
            "frame",
            "area"
          ]
        },
        "status": {
          "enum": [
            "unchanged",
            "added",
            "removed",
            "modified",
            "relabeled"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ],
          "description": "COLUMN/BEAM/BRACE, FLOOR/PANEL/AREA, null for points"
        },
        "before_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "<label>@<story> of the before object, null for added"
        },
        "after_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "<label>@<story> of the after object, null for removed"
        },
        "label": {
          "type": "string",
          "description": "after side label (before side for removed)"
        },
        "story": {
          "type": "string",
          "description": "after side story (before side for removed)"
        },
        "coords": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "description": "absolute ft, after side (before side for removed)"
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "offset": {
          "type": [
            "number",
            "null"
          ],
          "description": "ft. Largest vertex distance between the matched pair, null for added and removed"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        }
      }
    }
  }
}
