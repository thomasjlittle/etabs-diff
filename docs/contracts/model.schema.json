{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized ETABS model",
  "description": "Output of the parser, input of the diff engine. See docs/contracts/model-json.md.",
  "type": "object",
  "required": ["schema_version", "source", "units", "stories", "grids", "points", "frames", "areas", "definitions", "warnings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "source": {
      "type": "object",
      "required": ["file", "program", "program_version", "file_units"],
      "additionalProperties": false,
      "properties": {
        "file": {"type": "string"},
        "program": {"type": "string"},
        "program_version": {"type": ["string", "null"]},
        "file_units": {"$ref": "#/$defs/units"}
      }
    },
    "units": {
      "type": "object",
      "required": ["force", "length", "temperature"],
      "additionalProperties": false,
      "properties": {
        "force": {"const": "KIP"},
        "length": {"const": "FT"},
        "temperature": {"const": "F"}
      }
    },
    "stories": {
      "description": "Bottom to top. The first entry is the base level and has height null.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "elev", "height"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "elev": {"type": "number"},
          "height": {"type": ["number", "null"]}
        }
      }
    },
    "grids": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["system", "label", "dir", "coord"],
        "additionalProperties": false,
        "properties": {
          "system": {"type": "string"},
          "label": {"type": "string"},
          "dir": {"type": "string"},
          "coord": {"type": "number"}
        }
      }
    },
    "points": {"type": "array", "items": {"$ref": "#/$defs/point"}},
    "frames": {"type": "array", "items": {"$ref": "#/$defs/frame"}},
    "areas": {"type": "array", "items": {"$ref": "#/$defs/area"}},
    "definitions": {
      "description": "category -> name -> record. Records hold the e2k keywords after the name, values unit-converted.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": "object"}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "units": {
      "type": ["object", "null"],
      "required": ["force", "length", "temperature"],
      "additionalProperties": false,
      "properties": {
        "force": {"type": "string"},
        "length": {"type": "string"},
        "temperature": {"type": "string"}
      }
    },
    "xyz": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "node": {
      "type": "object",
      "required": ["point", "story"],
      "additionalProperties": false,
      "properties": {"point": {"type": "string"}, "story": {"type": "string"}}
    },
    "assigns": {
      "description": "e2k keyword -> value from the *ASSIGN lines for this (label, story).",
      "type": "object"
    },
    "loads": {
      "description": "Load pattern name (or UNIFLOADSET:<set>) -> list of load records in file order.",
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "object"}}
    },
    "base": {
      "type": "object",
      "required": ["id", "label", "story", "coords", "assigns", "loads"],
      "properties": {
        "id": {"type": "string", "description": "<label>@<story>, unique within one model. Display only; the diff matches on coords, never on labels."},
        "label": {"type": "string"},
        "story": {"type": "string"},
        "coords": {"type": "array", "items": {"$ref": "#/$defs/xyz"}, "minItems": 1},
        "assigns": {"$ref": "#/$defs/assigns"},
        "loads": {"$ref": "#/$defs/loads"}
      }
    },
    "point": {
      "allOf": [{"$ref": "#/$defs/base"}],
      "properties": {"coords": {"maxItems": 1}},
      "unevaluatedProperties": false
    },
    "frame": {
      "allOf": [{"$ref": "#/$defs/base"}],
      "required": ["type", "nodes"],
      "properties": {
        "type": {"enum": ["COLUMN", "BEAM", "BRACE"]},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}, "minItems": 2, "maxItems": 2},
        "coords": {"minItems": 2, "maxItems": 2}
      },
      "unevaluatedProperties": false
    },
    "area": {
      "allOf": [{"$ref": "#/$defs/base"}],
      "required": ["type", "nodes"],
      "properties": {
        "type": {"enum": ["FLOOR", "PANEL", "AREA"]},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}, "minItems": 3},
        "coords": {"minItems": 3}
      },
      "unevaluatedProperties": false
    }
  }
}
